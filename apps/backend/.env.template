# Integração fiscal — Brasil NFe (docs/superpowers/specs/2026-09-16-fiscal-brasilnfe-design.md)
# Valores reais ficam só no .env local/Railway. NUNCA commitar.
BRASILNFE_BASE_URL=https://api.brasilnfe.com.br
BRASILNFE_USER_TOKEN=
BRASILNFE_COMPANY_TOKEN=
BRASILNFE_WEBHOOK_SECRET=

# Pagamento — Mercado Pago (Parte 4; architecture/pagamento.md). Credenciais da aplicação
# "eclat-checkout" (Checkout Transparente via Orders API). Só no .env local / Railway. NUNCA commitar.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MAX_PARCELAS=4
MERCADOPAGO_PIX_EXPIRA_MIN=30

# E-mail transacional — Resend (architecture/email.md). Sem RESEND_API_KEY o backend sobe normal
# e nenhum e-mail sai. Só no .env local / Railway. NUNCA commitar.
RESEND_API_KEY=
# Remetente: precisa ser de um domínio verificado no Resend. Padrão: use.ÉCLAT <pedidos@useeclat.com.br>
RESEND_FROM=
# Para onde vai a resposta da cliente (opcional; o domínio ainda não tem caixa de entrada própria)
RESEND_REPLY_TO=
# Endereço da vitrine usado nos links e no logo do e-mail. Padrão: https://www.useeclat.com.br
STOREFRONT_URL=
